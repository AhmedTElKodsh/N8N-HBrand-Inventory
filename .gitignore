# Local credentials and authenticated browser state
.env
.env.*
!.env.example
browser-profiles/
storage-state*.json
cookies*.json

# Runtime data and full supplier workbooks belong outside source control
runtime/
data/
downloads/
backups/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
